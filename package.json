{
  "name": "docker_deploy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:frontend": "pnpm --dir frontend build",
    "build:all": "pnpm run build && pnpm run build:frontend"
  },
  "dependencies": {
    "express": "5.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.0",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3"
  }
}
